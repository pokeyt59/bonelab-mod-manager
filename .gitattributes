# Shell scripts have to keep Unix line endings whatever a checkout is
# configured to do. With CRLF they fail on Linux and macOS with a "bad
# interpreter" error naming a shell that looks correct, which is a miserable
# thing to debug.
*.sh text eol=lf

# PowerShell is the other way around, and Windows tooling expects CRLF.
*.ps1 text eol=crlf
